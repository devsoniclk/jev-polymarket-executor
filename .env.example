# Jev Polymarket Executor - Environment Variables

# OpenRouter API Key (required for Jev decisions)
OPENROUTER_API_KEY=sk-or-...

# Polymarket CLOB API credentials (required for live trading)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Trading mode (true = paper, false = live)
PAPER_MODE=true

# Edge threshold (0.08 = 8%)
MIN_EDGE=0.08

# Risk limits
MAX_PER_TRADE=10
MAX_EXPOSURE=100
DAILY_LOSS_LIMIT=50